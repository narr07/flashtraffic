{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Capabilities shared by every platform",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		"core:webview:allow-create-webview-window",
		"opener:default",
		"opener:allow-open-url",
		"shell:default",
		"shell:allow-open",
		"notification:default",
		"os:default",
		"store:default"
	]
}
