{
	"$schema": "https://schema.tauri.app/config/2",
	"bundle": {
		"active": true,
		"targets": "all",
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [],
		"externalBin": [],
		"copyright": "Copyright © 2026 FlashTraffic Team",
		"category": "DeveloperTool",
		"shortDescription": "Modern Web Traffic Simulation & Analytics Load Testing Desktop Platform",
		"longDescription": "FlashTraffic is a modern, high-performance desktop platform for simulating human-like web traffic, stress-testing analytics attribution, and validating real cloud devices via BrowserStack and Playwright.",
		"publisher": "narr07",
		"homepage": "https://narr07.github.io/flashtraffic"
	},
	"build": {
		"beforeBuildCommand": "bun run generate",
		"frontendDist": "../.output/public",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:3000"
	},
	"productName": "FlashTraffic",
	"version": "0.1.0",
	"identifier": "com.flashtraffic.app",
	"plugins": {},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "FlashTraffic - Traffic Simulation & Testing Platform",
				"width": 1400,
				"height": 850,
				"minWidth": 950,
				"minHeight": 650,
				"center": true,
				"resizable": true,
				"maximized": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' ipc: http://ipc.localhost",
				"connect-src": "'self' ipc: http://ipc.localhost https:",
				"img-src": "'self' data: blob: https:",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"script-src": "'self'"
			}
		}
	}
}
